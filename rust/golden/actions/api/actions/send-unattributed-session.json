{
  "request": {
    "method": "POST",
    "route": "/v1/inputs",
    "headers": {
      "content-type": "application/json",
      "expect": "100-continue"
    },
    "body": {
      "id": "<UUID:1>",
      "sessionId": "<unattributed>",
      "text": "hello"
    }
  },
  "response": {
    "status": 409,
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store",
      "connection": "keep-alive"
    },
    "body": {
      "error": "no_chat",
      "detail": "this session has no ChatGPT chat to send to"
    }
  }
}

{
  "request": {
    "method": "POST",
    "route": "/v1/inputs",
    "headers": {
      "content-type": "application/json",
      "expect": "100-continue"
    },
    "body": {
      "id": "<UUID:1>",
      "sessionId": "<UUID:2>",
      "text": "hello"
    }
  },
  "response": {
    "status": 404,
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store",
      "connection": "keep-alive"
    },
    "body": {
      "error": "session_not_found"
    }
  }
}

                  "key": {
                    "description": "Character or case-insensitive named key (Enter/Return, Escape/Esc, Tab, Space, arrows), optionally Control/Shift/Alt/Meta+key. Optional ref focuses that exact target first; otherwise uses current page focus.",
                    "type": "string",
                    "maxLength": 100

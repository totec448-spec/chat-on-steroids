                    "description": "Exact tabId returned by browser_tabs."
                  },
                  "pageId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|<UUID:1>|<UUID:2>)$",
                    "description": "Exact top-level pageId UUID from attach, snapshot or screenshot. Do not extract it from an element ref. Navigation invalidates it."
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "click",
                      "hover",
                      "fill",
                      "type",
                      "select",
                      "key",
                      "scroll",
                      "drag",
                      "dialog"
                    ]
                  },
                  "ref": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000
                  },

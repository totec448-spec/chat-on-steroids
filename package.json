{
  "name": "chat-on-steroids",
  "version": "2.1.14",
  "description": "Local coding bridge for ChatGPT over MCP, with native desktop control and approved-folder capability limits.",
  "license": "MIT",
  "author": "Chat On Steroids",
  "homepage": "https://github.com/totec448-spec/chat-on-steroids",
  "desktopName": "com.chatonsteroids.app.desktop",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify.mjs",
    "verify:notices": "node scripts/generate-third-party-notices.mjs --check && node scripts/package-native-sources.mjs --check",
    "verify:privacy": "node scripts/verify-public-history.mjs",
    "verify:tunnel-current": "node scripts/verify-current-tunnel.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "icon": "node scripts/make-icon.mjs",
    "tunnel": "node scripts/fetch-tunnel-client.mjs",
    "rg": "node scripts/fetch-ripgrep.mjs",
    "packaging:prepare": "node scripts/prepare-packaging-native.mjs",
    "desktop:mac": "node scripts/prepare-macos-desktop-helper.mjs --platform darwin",
    "dist": "node scripts/package.mjs --arch x64,arm64",
    "dist:dir": "node scripts/package.mjs --arch x64,arm64 --dir",
    "test:kill": "node scripts/kill-stray-vitest.mjs"
  },
  "dependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "6.7.6",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@lezer/highlight": "^1.2.4",
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "js-yaml": "5.4.2",
    "marked": "18.0.14",
    "node-pty": "1.2.0-beta.15",
    "pdfjs-dist": "^6.3.289",
    "quickjs-emscripten-core": "0.32.0",
    "sharp": "0.35.4",
    "smol-toml": "1.9.0",
    "tree-sitter": "0.25.1",
    "tree-sitter-bash": "0.25.1",
    "ws": "8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/ws": "8.18.1",
    "electron": "44.4.5",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@anthropic-ai/mcpb": {
      "tmp": "0.2.7"
    }
  },
  "engines": {
    "node": ">=24 <25"
  }
}
